{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabbix.com/6.0/api/hostinterface/hostinterface.massremove",
  "title": "hostinterface.massremove",
  "description": "This method allows to remove host interfaces from the given hosts.",
  "$comment": "Source: https://www.zabbix.com/documentation/6.0/en/manual/api/reference/hostinterface/massremove",
  "type": "object",
  "properties": {
    "hostids": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "IDs of the hosts to be updated."
    },
    "interfaces": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "dns": {
              "type": "string",
              "description": "DNS name used by the interface."
            },
            "ip": {
              "type": "string",
              "description": "IP address used by the interface."
            },
            "port": {
              "type": "string",
              "description": "Port number used by the interface."
            }
          },
          "required": ["ip", "dns", "port"]
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dns": {
                "type": "string",
                "description": "DNS name used by the interface."
              },
              "ip": {
                "type": "string",
                "description": "IP address used by the interface."
              },
              "port": {
                "type": "string",
                "description": "Port number used by the interface."
              }
            },
            "required": ["ip", "dns", "port"]
          }
        }
      ],
      "description": "Host interfaces to remove from the given hosts. The host interface object must have the ip, dns and port properties defined."
    }
  },
  "required": ["hostids", "interfaces"],
  "additionalProperties": false
}
