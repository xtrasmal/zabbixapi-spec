{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabbix.com/6.0/api/template/template.massupdate",
  "title": "template.massupdate",
  "description": "This method allows to simultaneously replace or remove related objects and update properties on multiple templates.",
  "$comment": "Source: https://www.zabbix.com/documentation/6.0/en/manual/api/reference/template/massupdate",
  "type": "object",
  "properties": {
    "templates": {
      "oneOf": [
        { "type": "object" },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "templateid": { "type": "string", "description": "ID of the template." }
            },
            "required": ["templateid"],
            "additionalProperties": false
          }
        }
      ],
      "description": "Templates to be updated. The templates must have the templateid property defined."
    },
    "groups": {
      "oneOf": [
        { "type": "object" },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "groupid": { "type": "string", "description": "ID of the host group." }
            },
            "required": ["groupid"],
            "additionalProperties": false
          }
        }
      ],
      "description": "Host groups to replace the current host groups the templates belong to. The host groups must have the groupid property defined."
    },
    "macros": {
      "oneOf": [
        { "type": "object" },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "macro": { "type": "string", "description": "Macro string." },
              "value": { "type": "string", "description": "Value of the macro." },
              "type": {
                "type": "integer",
                "enum": [0, 1, 2],
                "description": "Type of macro. Possible values: 0 - (default) Text macro; 1 - Secret macro; 2 - Vault secret."
              },
              "description": { "type": "string", "description": "Description of the macro." }
            },
            "required": ["macro", "value"],
            "additionalProperties": false
          }
        }
      ],
      "description": "User macros to replace the current user macros on the given templates."
    },
    "templates_clear": {
      "oneOf": [
        { "type": "object" },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "templateid": { "type": "string", "description": "ID of the template." }
            },
            "required": ["templateid"],
            "additionalProperties": false
          }
        }
      ],
      "description": "Templates to unlink and clear from the given templates. The templates must have the templateid property defined."
    },
    "templates_link": {
      "oneOf": [
        { "type": "object" },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "templateid": { "type": "string", "description": "ID of the template." }
            },
            "required": ["templateid"],
            "additionalProperties": false
          }
        }
      ],
      "description": "Templates to replace the currently linked templates. The templates must have the templateid property defined."
    }
  },
  "required": ["templates"],
  "additionalProperties": false
}
