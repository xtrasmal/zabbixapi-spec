{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabbix.com/7.0/api/regexp/regexp.update",
  "title": "regexp.update",
  "description": "Update existing global regular expressions.",
  "$comment": "Source: https://www.zabbix.com/documentation/7.0/en/manual/api/reference/regexp/update",
  "type": "object",
  "properties": {
    "regexpid": {
      "type": "string",
      "description": "ID of the regular expression. Read-only. Required for update operations."
    },
    "name": {
      "type": "string",
      "description": "Name of the regular expression."
    },
    "test_string": {
      "type": "string",
      "description": "Test string."
    },
    "expressions": {
      "type": "array",
      "description": "Expressions options.",
      "items": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "description": "Regular expression. Required."
          },
          "expression_type": {
            "type": "integer",
            "enum": [0, 1, 2, 3, 4],
            "description": "Type of Regular expression. Required. Possible values: 0 - Character string included; 1 - Any character string included; 2 - Character string not included; 3 - Result is TRUE; 4 - Result is FALSE."
          },
          "exp_delimiter": {
            "type": "string",
            "enum": [",", ".", "/"],
            "description": "Expression delimiter. Supported if expression_type is set to \"Any character string included\". Default: \",\"."
          },
          "case_sensitive": {
            "type": "integer",
            "enum": [0, 1],
            "description": "Case sensitivity. Possible values: 0 - Case insensitive; 1 - Case sensitive. Default: 0."
          }
        },
        "required": ["expression", "expression_type"],
        "additionalProperties": false
      }
    }
  },
  "required": ["regexpid"],
  "additionalProperties": false
}
